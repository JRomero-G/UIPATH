# .env.example
# Copia este archivo a .env y rellena los valores reales.
# El .env NUNCA se sube al control de versiones (esta en .gitignore), pero SI
# se empaqueta dentro del instalador y se instala junto al .exe en cada equipo
# cliente. Todo lo que pongas aqui acaba siendo legible por el usuario final:
# no metas credenciales que no puedan salir de la organizacion.

# === BASE DE DATOS (MySQL) - solo la usa el backend ===
DB_USER=usuario
DB_PASSWORD=contrasena
DB_HOST=host
DB_PORT=3306
DATABASE=nombre_db
DATABASE_URL=mysql+mysqlconnector://usuario:contrasena@host:3306/nombre_db

# === BACKEND ===
# URL del servicio desplegado en Google Cloud Run. Es lo unico que el
# frontend necesita para funcionar.
BACKEND_URL=https://importadora-cruz-966268191098.europe-west1.run.app
BACKEND_PORT=8000
# Despliegue alternativo (Render), historico.
BACKEND_URL2=RENDER

# === GOOGLE CLOUD ===
# Ruta al JSON de service account usado por los scripts de generacion.
CREDENTIALS_GEMINI=ruta/al/service_account.json
GEMINI_CREDENTIALS=ruta/al/service_account.json
# JSON de service account en linea (o ruta). Lo usa el frontend para
# descargar fichas tecnicas y proformas desde el bucket.
RENDER_CRENDENTIALS_JSON={"type":"service_account","project_id":"..."}
BUCKET_NAME=nombre-del-bucket

# === HASHING / JWT ===
SECRET_KEY_JWT=clave_larga_y_aleatoria
ALGORITHM=HS256
# 8 horas
ACCESS_TOKEN_EXPIRE_MINUTES=480
MAX_PASSWORD_BYTES=72

# === AUTOACTUALIZADOR (src/utils/updater.py) ===
# Token de GitHub con permiso de lectura de releases en mmedinafv/UIPATH.
# Sin el, la app no puede descargar Installer_Gestorex_v<version>.exe.
GITHUB_KEY=ghp_tu_token_aqui
